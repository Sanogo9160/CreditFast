APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.creditfast.ml

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OCR réel (Tesseract + texte PDF). Installez Tesseract : https://github.com/tesseract-ocr/tesseract
# Windows Laragon : souvent "C:\Program Files\Tesseract-OCR\tesseract.exe"
TESSERACT_BINARY=
OCR_LANGUAGES=fra+eng
OCR_TIMEOUT=60
OCR_PDF_MIN_TEXT_LENGTH=80
OCR_MAX_PDF_PAGES=3
OCR_PDF_DENSITY=200
# Ghostscript (délégué PDF d’Imagick). Ex. C:\Program Files\gs\gs10.08.0\bin\gswin64c.exe
GHOSTSCRIPT_BINARY=
# Optionnel : dossier config ImageMagick (Laragon : ...\php-8.3.x\imagick-config)
IMAGICK_CONFIGURE_PATH=

# Taux d’intérêt institutionnel unique (tous les dossiers)
CREDIT_ANNUAL_INTEREST_RATE=15

# Scoring — plafond de prudence (le score global n’atteint jamais 100)
CREDIT_SCORE_CEILING=95

# Comptes internes de démarrage (aucun client ni dossier fictif)
STAFF_BOOTSTRAP_PASSWORD=ChangeMe-CreditFast-2026!
STAFF_ADMIN_EMAIL=admin@creditfast.ml
STAFF_AGENT_EMAIL=agent@creditfast.ml
STAFF_ANALYST_EMAIL=analyste@creditfast.ml
STAFF_COMMITTEE_EMAIL=comite@creditfast.ml

# Swagger / OpenAPI (UI : /api/documentation)
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://creditfast.test
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.0.0
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true
L5_SWAGGER_USE_ABSOLUTE_PATH=false
L5_SWAGGER_UI_DOC_EXPANSION=list

